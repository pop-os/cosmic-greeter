restart-timeout =
    სისტემა ავტომატურად გადაიტვირთება
    { $seconds ->
        [0] ახლავე.
        [1] 1 წამში.
       *[other] { $seconds } წამში.
    }
shutdown-timeout =
    სისტემა ავტომატურად გამოირთვება
    { $seconds ->
        [0] ახლავე.
        [1] 1 წამში.
       *[other] { $seconds } წამში.
    }
