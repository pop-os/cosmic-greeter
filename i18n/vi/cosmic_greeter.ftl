cancel = Hủy bỏ
session = Phiên
suspend = Tạm ngưng
user = Người dùng
auth-error-default = Xác thực không thành công. Vui lòng thử lại.
auth-error-credentials = Mật khẩu không chính xác. Vui lòng kiểm tra bố cục bàn phím của bạn và thử lại.
auth-error-denied = Truy cập bị từ chối.
auth-error-maxtries = Quá nhiều lần xác thực không thành công.
auth-error-account = Tài khoản không có sẵn hoặc bị vô hiệu hóa.
restart-timeout =
    Hệ thống sẽ tự động khởi động lại
    { $seconds ->
        [0] now.
        [1] in 1 second.
       *[other] in { $seconds } giây.
    }
shutdown-timeout =
    Hệ thống sẽ tự động tắt nguồn
    { $seconds ->
        [0] bây giờ.
        [1] trong 1 giây.
       *[other] trong { $seconds } giây.
    }
